<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/dockMenu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_quick_button"
        android:backgroundTint="@color/accent_cyan"
        android:contentDescription="@string/dock_menu"
        android:padding="11dp"
        android:src="@drawable/ic_apps"
        app:tint="@color/white" />

    <ImageButton
        android:id="@+id/dockSettings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_quick_button"
        android:backgroundTint="@color/accent_gray"
        android:contentDescription="@string/dock_settings"
        android:padding="11dp"
        android:src="@drawable/ic_settings"
        app:tint="@color/white" />
</LinearLayout>
