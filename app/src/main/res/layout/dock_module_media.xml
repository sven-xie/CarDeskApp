<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/dockAlbumArt"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_album_art"
        android:clipToOutline="true"
        android:outlineProvider="background">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/media_song"
            android:src="@drawable/ic_music"
            app:tint="@color/white" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dockMediaTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/media_song"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/dockMediaArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/media_artist"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/dockPrevious"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/media_previous"
        android:padding="7dp"
        android:src="@drawable/ic_prev"
        app:tint="@color/text_primary" />

    <ImageButton
        android:id="@+id/dockPlayPause"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/media_pause"
        android:padding="7dp"
        android:src="@drawable/ic_pause"
        app:tint="@color/text_primary" />

    <ImageButton
        android:id="@+id/dockNext"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/media_next"
        android:padding="7dp"
        android:src="@drawable/ic_next"
        app:tint="@color/text_primary" />
</LinearLayout>
