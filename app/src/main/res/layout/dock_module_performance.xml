<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.sven.cardesk.widget.CylinderGaugeView
        android:id="@+id/cpuGauge"
        android:layout_width="58dp"
        android:layout_height="44dp"
        app:gaugeColor="@color/accent_cyan"
        app:gaugeLabel="@string/dock_cpu" />

    <com.sven.cardesk.widget.CylinderGaugeView
        android:id="@+id/memGauge"
        android:layout_width="58dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        app:gaugeColor="@color/accent_purple"
        app:gaugeLabel="@string/dock_mem" />

    <com.sven.cardesk.widget.CylinderGaugeView
        android:id="@+id/tempGauge"
        android:layout_width="58dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        app:gaugeColor="@color/accent_orange"
        app:gaugeLabel="@string/dock_temp" />
</LinearLayout>
