<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/dockWeatherIconBg"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/accent_yellow">

        <ImageView
            android:id="@+id/dockWeatherIcon"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_gravity="center"
            android:contentDescription="@string/dock_weather"
            android:src="@drawable/ic_sun"
            app:tint="@color/black" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dockWeatherTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/weather_unavailable"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/dockWeatherDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/weather_loading"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
