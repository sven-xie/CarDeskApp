<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dockRoot"
    android:layout_width="match_parent"
    android:layout_height="74dp"
    app:cardBackgroundColor="@color/dock_surface"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/dockBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <LinearLayout
            android:id="@+id/dockContent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/dockMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_quick_button"
                android:backgroundTint="@color/accent_cyan"
                android:contentDescription="@string/dock_menu"
                android:padding="11dp"
                android:src="@drawable/ic_apps"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/dockSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_quick_button"
                android:backgroundTint="@color/accent_gray"
                android:contentDescription="@string/dock_settings"
                android:padding="11dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/white" />

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="8dp"
                android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/dockConnectivitySection"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/dockBluetooth"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_quick_button"
                    android:backgroundTint="@color/card_surface_alt"
                    android:contentDescription="@string/dock_bt_off"
                    android:padding="10dp"
                    android:src="@drawable/ic_bluetooth"
                    app:tint="@color/text_tertiary" />

                <ImageButton
                    android:id="@+id/dockWifi"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_quick_button"
                    android:backgroundTint="@color/card_surface_alt"
                    android:contentDescription="@string/dock_wifi_off"
                    android:padding="10dp"
                    android:src="@drawable/ic_wifi"
                    app:tint="@color/text_tertiary" />

                <ImageButton
                    android:id="@+id/dockVolumeDown"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_quick_button"
                    android:backgroundTint="@color/accent_purple"
                    android:contentDescription="@string/dock_volume_down"
                    android:padding="10dp"
                    android:src="@drawable/ic_volume_down"
                    app:tint="@color/white" />

                <ImageButton
                    android:id="@+id/dockVolumeUp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_quick_button"
                    android:backgroundTint="@color/accent_purple"
                    android:contentDescription="@string/dock_volume_up"
                    android:padding="10dp"
                    android:src="@drawable/ic_volume_up"
                    app:tint="@color/white" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="8dp"
                android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/dockPerfSection"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.sven.cardesk.widget.CylinderGaugeView
                    android:id="@+id/cpuGauge"
                    android:layout_width="58dp"
                    android:layout_height="44dp"
                    app:gaugeColor="@color/accent_cyan"
                    app:gaugeLabel="@string/dock_cpu" />

                <com.sven.cardesk.widget.CylinderGaugeView
                    android:id="@+id/memGauge"
                    android:layout_width="58dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    app:gaugeColor="@color/accent_purple"
                    app:gaugeLabel="@string/dock_mem" />

                <com.sven.cardesk.widget.CylinderGaugeView
                    android:id="@+id/tempGauge"
                    android:layout_width="58dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    app:gaugeColor="@color/accent_orange"
                    app:gaugeLabel="@string/dock_temp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="8dp"
                android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/dockMusicSection"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/dockAlbumArt"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_album_art"
                    android:clipToOutline="true"
                    android:outlineProvider="background">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/media_song"
                        android:src="@drawable/ic_music"
                        app:tint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dockMediaTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/media_song"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/dockMediaArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/media_artist"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/dockPrevious"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/media_previous"
                    android:padding="7dp"
                    android:src="@drawable/ic_prev"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/dockPlayPause"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/media_pause"
                    android:padding="7dp"
                    android:src="@drawable/ic_pause"
                    app:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/dockNext"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/media_next"
                    android:padding="7dp"
                    android:src="@drawable/ic_next"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="8dp"
                android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/dockWeatherSection"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/dockWeatherIconBg"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/accent_yellow">

                    <ImageView
                        android:id="@+id/dockWeatherIcon"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/dock_weather"
                        android:src="@drawable/ic_sun"
                        app:tint="@color/black" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dockWeatherTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/weather_unavailable"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/dockWeatherDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/weather_loading"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="8dp"
                android:background="@color/divider" />

            <LinearLayout
                android:id="@+id/dockClockSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dockDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dock_date"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/dockClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/dock_clock"
                    android:textColor="@color/text_primary"
                    android:textSize="26sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
