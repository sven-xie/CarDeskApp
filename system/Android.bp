// CarDesk (com.sven.cardesk) as a privileged, platform-signed system app.
// Built APK: app-release-unsigned.apk from G:\workspace\MyCar\CarDeskApp,
// compiled with compileSdk 37 / targetSdk 34 for this Android 14 system image.

prebuilt_etc {
    name: "privapp-permissions-mycardesk",
    src: "privapp-permissions-mycardesk.xml",
    sub_dir: "permissions",
    filename_from_src: true,
}

prebuilt_etc {
    name: "default-permissions-mycardesk",
    src: "default-permissions-mycardesk.xml",
    sub_dir: "default-permissions",
    filename_from_src: true,
}

android_app_import {
    name: "MyCarDesk",
    apk: "MyCarDesk.apk",
    certificate: "platform",
    privileged: true,
    // CarDesk is the only HOME app in the tablet product.
    overrides: [
        "Launcher3QuickStep",
        "Launcher3",
        "Launcher3Go",
        "Launcher3QuickStepGo",
    ],
    required: [
        "privapp-permissions-mycardesk",
        "default-permissions-mycardesk",
    ],
    dex_preopt: {
        enabled: false,
    },
}
