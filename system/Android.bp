// MyCarDesk Android source integration.
//
// 1. Build the APK with Gradle.
// 2. Copy it to this directory as MyCarDesk.apk.
// 3. Add this directory to the product's PRODUCT_PACKAGES, e.g.:
//      PRODUCT_PACKAGES += MyCarDesk
// 4. If the product uses a different default launcher, adjust `overrides` below.
//
// `certificate: "platform"` re-signs the APK with the platform key when
// `presigned` is false. If you provide an APK already signed with the platform
// key, set `presigned: true` and remove `certificate`.

prebuilt_etc {
    name: "privapp-permissions-mycardesk.xml",
    src: "privapp-permissions-mycardesk.xml",
    sub_dir: "permissions",
    filename_from_src: true,
}

android_app_import {
    name: "MyCarDesk",
    apk: "MyCarDesk.apk",
    certificate: "platform",
    privileged: true,
    // If this product includes Launcher3 and MyCarDesk should replace it, uncomment:
    // overrides: ["Launcher3"],
    required: ["privapp-permissions-mycardesk.xml"],
    dex_preopt: {
        enabled: false,
    },
}
